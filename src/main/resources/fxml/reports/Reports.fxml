<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gp.grocerypos.controller.reports.ReportsController"
      styleClass="dashboard-root" spacing="0">

    <!-- ═══ LEFT — Report selector ═══ -->
    <VBox prefWidth="260" spacing="12"
          style="-fx-background-color: #1e2a3a; -fx-padding: 20;">
        <Label text="Reports" style="-fx-font-size: 18px; -fx-font-weight: bold;
                                     -fx-text-fill: white;"/>
        <Label text="Select a report:" style="-fx-text-fill: #90a4ae; -fx-font-size: 11px;"/>
        <ListView fx:id="reportList" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #263040; -fx-border-color: #37474f;
                         -fx-text-fill: white; -fx-font-size: 13px;"/>
    </VBox>

    <!-- ═══ RIGHT — Parameters + actions ═══ -->
    <VBox HBox.hgrow="ALWAYS" spacing="20"
          style="-fx-background-color: #f0f2f5; -fx-padding: 28;">

        <!-- Description -->
        <VBox spacing="6">
            <Label text="REPORT DESCRIPTION"
                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #546e7a;"/>
            <Label fx:id="lblDescription" text=""
                   wrapText="true" maxWidth="520"
                   style="-fx-text-fill: #37474f; -fx-font-size: 13px;"/>
        </VBox>

        <Separator/>

        <!-- Date range parameters -->
        <VBox spacing="12">
            <Label text="PARAMETERS"
                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #546e7a;"/>
            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label fx:id="lblFromDate" text="From Date" styleClass="login-field-label"/>
                    <DatePicker fx:id="fromDatePicker" prefWidth="160"/>
                </VBox>
                <VBox spacing="4">
                    <Label fx:id="lblToDate" text="To Date" styleClass="login-field-label"/>
                    <DatePicker fx:id="toDatePicker" prefWidth="160"/>
                </VBox>
            </HBox>
        </VBox>

        <Separator/>

        <!-- Action buttons -->
        <VBox spacing="10">
            <Label text="ACTIONS"
                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #546e7a;"/>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="btnRun" text="▶  Run Report"
                        onAction="#handleRun"
                        style="-fx-background-color: #1a237e; -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-font-weight: bold;
                               -fx-pref-width: 160; -fx-pref-height: 42;
                               -fx-background-radius: 6; -fx-cursor: hand;"/>
                <Button fx:id="btnExportPdf" text="⬇  Export PDF"
                        onAction="#handleExportPdf"
                        style="-fx-background-color: #c62828; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-font-weight: bold;
                               -fx-pref-width: 150; -fx-pref-height: 42;
                               -fx-background-radius: 6; -fx-cursor: hand;"/>
                <Button fx:id="btnPrint" text="🖨  Print"
                        onAction="#handlePrint"
                        style="-fx-background-color: #2e7d32; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-font-weight: bold;
                               -fx-pref-width: 130; -fx-pref-height: 42;
                               -fx-background-radius: 6; -fx-cursor: hand;"/>
                <ProgressIndicator fx:id="spinner" prefWidth="28" prefHeight="28" visible="false"/>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Status bar -->
        <Label fx:id="statusLabel" text="Select a report and click Run."
               style="-fx-text-fill: #546e7a; -fx-font-size: 12px;
                      -fx-background-color: white; -fx-padding: 8 12;
                      -fx-background-radius: 4; -fx-border-color: #e0e0e0;
                      -fx-border-radius: 4;" maxWidth="Infinity"/>

    </VBox>
</HBox>
