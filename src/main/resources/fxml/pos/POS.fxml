<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gp.grocerypos.controller.pos.POSController"
            style="-fx-background-color: #f0f2f5;">

    <!-- ═══ TOP — POS Header bar ═══ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="24"
              style="-fx-background-color: #1a237e; -fx-padding: 10 20;">
            <Label text="🛒  POS Billing"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblCashier"
                   style="-fx-text-fill: #c5cae9; -fx-font-size: 12px;"/>
            <Label fx:id="lblDateTime" text=""
                   style="-fx-text-fill: #90caf9; -fx-font-size: 12px;"/>
            <Label fx:id="lblLastSale" text=""
                   style="-fx-text-fill: #a5d6a7; -fx-font-size: 11px;"/>
        </HBox>
    </top>

    <!-- ═══ CENTER — Cart + Product entry ═══ -->
    <center>
        <VBox spacing="0">

            <!-- Customer + Barcode entry strip -->
            <HBox spacing="0"
                  style="-fx-background-color: #283593; -fx-padding: 10 20; -fx-spacing: 16;">

                <!-- Customer search -->
                <HBox spacing="6" alignment="CENTER_LEFT" prefWidth="320">
                    <TextField fx:id="customerSearchField"
                               promptText="Customer phone or name..."
                               prefWidth="220"
                               style="-fx-font-size: 13px; -fx-pref-height: 36;
                                      -fx-background-radius: 4; -fx-border-radius: 4;"/>
                    <Button text="Find" onAction="#handleCustomerSearch"
                            style="-fx-background-color: #3949ab; -fx-text-fill: white;
                                   -fx-pref-height: 36; -fx-cursor: hand;
                                   -fx-background-radius: 4;"/>
                    <Button fx:id="btnClearCustomer" text="✕"
                            onAction="#handleClearCustomer"
                            style="-fx-background-color: transparent; -fx-text-fill: #ef9a9a;
                                   -fx-cursor: hand; -fx-font-size: 14px;"/>
                </HBox>
                <Label fx:id="lblCustomerName" text="Walk-in customer"
                       style="-fx-text-fill: #c5cae9; -fx-font-size: 13px;
                              -fx-min-width: 200;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Barcode entry -->
                <HBox spacing="8" alignment="CENTER_RIGHT">
                    <Label text="Barcode / Name:"
                           style="-fx-text-fill: #90caf9; -fx-font-weight: bold;"/>
                    <TextField fx:id="barcodeField"
                               promptText="Scan barcode or type name + Enter"
                               prefWidth="300"
                               onAction="#handleBarcodeEnter"
                               style="-fx-font-size: 15px; -fx-font-weight: bold;
                                      -fx-pref-height: 40;
                                      -fx-background-radius: 4; -fx-border-radius: 4;"/>
                    <Label fx:id="lblProductInfo" text=""
                           style="-fx-font-size: 12px; -fx-min-width: 180;
                                  -fx-text-fill: #a5d6a7;"/>
                </HBox>
            </HBox>

            <!-- Cart table -->
            <TableView fx:id="cartTable" VBox.vgrow="ALWAYS"
                       onMouseClicked="#handleQtyEdit"
                       style="-fx-background-color: white;">
                <columns>
                    <TableColumn fx:id="colBarcode"     text="Barcode"    prefWidth="120"/>
                    <TableColumn fx:id="colProductName" text="Product"    prefWidth="260"/>
                    <TableColumn fx:id="colQty"         text="Qty"        prefWidth="70"/>
                    <TableColumn fx:id="colUnitPrice"   text="Unit Price" prefWidth="120"/>
                    <TableColumn fx:id="colDiscount"    text="Discount"   prefWidth="100"/>
                    <TableColumn fx:id="colTotal"       text="Total"      prefWidth="120"/>
                </columns>
                <placeholder>
                    <Label text="Cart is empty. Scan a barcode to add products."
                           style="-fx-font-size: 15px; -fx-text-fill: #90a4ae;"/>
                </placeholder>
            </TableView>
        </VBox>
    </center>

    <!-- ═══ RIGHT — Totals + actions panel ═══ -->
    <right>
        <VBox spacing="0" prefWidth="300"
              style="-fx-background-color: #1e2a3a;">

            <!-- Totals section -->
            <VBox spacing="12" style="-fx-padding: 20;">

                <HBox alignment="CENTER_LEFT">
                    <Label text="Subtotal" style="-fx-text-fill: #90a4ae;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSubtotal" text="Rs. 0.00"
                           style="-fx-text-fill: white; -fx-font-size: 13px;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT">
                    <Label text="Discount" style="-fx-text-fill: #90a4ae;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblDiscount" text="Rs. 0.00"
                           style="-fx-text-fill: #ef9a9a; -fx-font-size: 13px;"/>
                </HBox>

                <HBox fx:id="lblTaxRow" alignment="CENTER_LEFT" visible="false" managed="false">
                    <Label text="Tax" style="-fx-text-fill: #90a4ae;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTax" text="Rs. 0.00"
                           style="-fx-text-fill: #fff59d; -fx-font-size: 13px;"
                           visible="false" managed="false"/>
                </HBox>

                <Separator style="-fx-background-color: #37474f;"/>

                <VBox spacing="4">
                    <Label text="GRAND TOTAL"
                           style="-fx-text-fill: #90caf9; -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>
                    <Label fx:id="lblGrandTotal" text="Rs. 0.00"
                           style="-fx-text-fill: white; -fx-font-size: 30px;
                                  -fx-font-weight: bold;"/>
                </VBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Action buttons -->
            <VBox spacing="8" style="-fx-padding: 16;">

                <!-- Pay button — primary action -->
                <Button fx:id="btnPay" text="💳  PAY  (F10)"
                        maxWidth="Infinity" disable="true"
                        onAction="#handlePay"
                        style="-fx-background-color: #2e7d32; -fx-text-fill: white;
                               -fx-font-size: 18px; -fx-font-weight: bold;
                               -fx-pref-height: 56; -fx-background-radius: 8;
                               -fx-cursor: hand;"/>

                <HBox spacing="8">
                    <Button fx:id="btnRemove" text="🗑 Remove"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            onAction="#handleRemoveItem"
                            style="-fx-background-color: #b71c1c; -fx-text-fill: white;
                                   -fx-pref-height: 38; -fx-background-radius: 6;
                                   -fx-cursor: hand;"/>
                    <Button fx:id="btnClearCart" text="✕ Clear"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            onAction="#handleClearCart"
                            style="-fx-background-color: #37474f; -fx-text-fill: white;
                                   -fx-pref-height: 38; -fx-background-radius: 6;
                                   -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <!-- Status bar -->
            <Label fx:id="lblStatus" text="Ready."
                   style="-fx-text-fill: #546e7a; -fx-font-size: 11px;
                          -fx-padding: 6 16; -fx-background-color: #0d1b2a;
                          -fx-max-width: Infinity;" maxWidth="Infinity"/>
        </VBox>
    </right>

</BorderPane>
