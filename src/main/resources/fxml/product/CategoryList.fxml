<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gp.grocerypos.controller.product.CategoryController"
      styleClass="dashboard-root" spacing="16">

    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <!-- Header row -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Product Categories" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnAdd" text="+ Add Category" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <!-- Search + action bar -->
    <HBox alignment="CENTER_LEFT" spacing="8">
        <TextField fx:id="searchField" promptText="Search categories..."
                   prefWidth="280" styleClass="text-field"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnEdit"         text="Edit"       styleClass="btn-secondary" onAction="#handleEdit"/>
        <Button fx:id="btnToggleStatus" text="Deactivate" styleClass="btn-secondary" onAction="#handleToggleStatus"/>
        <Button text="Refresh" styleClass="btn-secondary" onAction="#handleRefresh"/>
    </HBox>

    <!-- Table -->
    <TableView fx:id="tableView" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colId"          text="ID"          prefWidth="60"/>
            <TableColumn fx:id="colName"        text="Name"        prefWidth="220"/>
            <TableColumn fx:id="colDescription" text="Description" prefWidth="340"/>
            <TableColumn fx:id="colStatus"      text="Status"      prefWidth="100"/>
        </columns>
        <placeholder><Label text="No categories found."/></placeholder>
    </TableView>

    <!-- Status bar -->
    <Label fx:id="statusLabel" text="" style="-fx-text-fill: #546e7a; -fx-font-size: 12px;"/>

</VBox>
