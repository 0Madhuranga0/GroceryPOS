<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gp.grocerypos.controller.supplier.SupplierDialogController"
      spacing="14" prefWidth="460"
      style="-fx-background-color: white; -fx-padding: 24;">

    <Label fx:id="titleLabel" text="Add Supplier" styleClass="page-title"/>

    <Label fx:id="errorLabel" text="" wrapText="true" visible="false"
           style="-fx-text-fill: #c62828; -fx-font-size: 12px;" maxWidth="410"/>

    <!-- Row 1: Name -->
    <VBox spacing="4">
        <Label text="Supplier Name *" styleClass="login-field-label"/>
        <TextField fx:id="nameField" promptText="Company or person name"
                   styleClass="text-field" maxWidth="410"/>
    </VBox>

    <!-- Row 2: Contact person + Phone (side by side) -->
    <HBox spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Contact Person" styleClass="login-field-label"/>
            <TextField fx:id="contactField" promptText="Contact name"
                       styleClass="text-field" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Phone" styleClass="login-field-label"/>
            <TextField fx:id="phoneField" promptText="Phone number"
                       styleClass="text-field" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <!-- Row 3: Email + Status (side by side) -->
    <HBox spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Email" styleClass="login-field-label"/>
            <TextField fx:id="emailField" promptText="Email address"
                       styleClass="text-field" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="4" prefWidth="130">
            <Label text="Status" styleClass="login-field-label"/>
            <ComboBox fx:id="statusCombo" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <!-- Row 4: Address -->
    <VBox spacing="4">
        <Label text="Address" styleClass="login-field-label"/>
        <TextArea fx:id="addressField" promptText="Business address"
                  prefRowCount="2" maxWidth="410" wrapText="true"/>
    </VBox>

    <!-- Row 5: Notes -->
    <VBox spacing="4">
        <Label text="Notes" styleClass="login-field-label"/>
        <TextArea fx:id="notesField" promptText="Any additional notes"
                  prefRowCount="2" maxWidth="410" wrapText="true"/>
    </VBox>

    <!-- Buttons -->
    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button fx:id="btnCancel" text="Cancel" styleClass="btn-secondary" onAction="#handleCancel"/>
        <Button fx:id="btnSave"   text="Save"   styleClass="btn-primary" defaultButton="true" onAction="#handleSave"/>
    </HBox>

</VBox>
