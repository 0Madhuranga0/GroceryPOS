<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="current_stock" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="30" bottomMargin="30" whenNoDataType="AllSectionsNoDetail">

    <parameter name="STORE_NAME" class="java.lang.String" isForPrompting="false"/>
    <parameter name="CURRENCY"   class="java.lang.String" isForPrompting="false"/>

    <queryString>
        <![CDATA[
        SELECT
            p.barcode,
            p.name                              AS product_name,
            COALESCE(c.name, '—')               AS category,
            p.unit,
            p.current_stock,
            p.minimum_stock,
            p.selling_price,
            p.purchase_price,
            p.current_stock * p.purchase_price  AS stock_value,
            CASE WHEN p.current_stock <= p.minimum_stock THEN 'LOW'
                 WHEN p.current_stock = 0 THEN 'OUT'
                 ELSE 'OK' END                  AS stock_status,
            p.expiry_date
        FROM   products p
        LEFT JOIN categories c ON c.id = p.category_id
        WHERE  p.status = 'ACTIVE'
        ORDER  BY c.name, p.name
        ]]>
    </queryString>

    <field name="barcode"       class="java.lang.String"/>
    <field name="product_name"  class="java.lang.String"/>
    <field name="category"      class="java.lang.String"/>
    <field name="unit"          class="java.lang.String"/>
    <field name="current_stock" class="java.math.BigDecimal"/>
    <field name="minimum_stock" class="java.math.BigDecimal"/>
    <field name="selling_price" class="java.math.BigDecimal"/>
    <field name="purchase_price"class="java.math.BigDecimal"/>
    <field name="stock_value"   class="java.math.BigDecimal"/>
    <field name="stock_status"  class="java.lang.String"/>
    <field name="expiry_date"   class="java.sql.Date"/>

    <variable name="TOTAL_VALUE" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
        <variableExpression><![CDATA[$F{stock_value}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <title>
        <band height="76">
            <textField><reportElement x="0" y="0" width="535" height="22"/>
                <textElement textAlignment="Center"><font size="15" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{STORE_NAME}]]></textFieldExpression></textField>
            <staticText><reportElement x="0" y="24" width="535" height="18"/>
                <textElement textAlignment="Center"><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Current Stock Report]]></text></staticText>
            <textField pattern="dd/MM/yyyy HH:mm"><reportElement x="0" y="44" width="535" height="14"/>
                <textElement textAlignment="Center"><font size="9" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
            <line><reportElement x="0" y="68" width="535" height="1"/></line>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <rectangle><reportElement x="0" y="0" width="535" height="20" backcolor="#283593"/>
                <graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
            <staticText><reportElement x="0"   y="2" width="165" height="16" forecolor="#FFFFFF"/>
                <textElement><font isBold="true" size="8"/></textElement><text><![CDATA[Product]]></text></staticText>
            <staticText><reportElement x="165" y="2" width="100" height="16" forecolor="#FFFFFF"/>
                <textElement><font isBold="true" size="8"/></textElement><text><![CDATA[Category]]></text></staticText>
            <staticText><reportElement x="265" y="2" width="45"  height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font isBold="true" size="8"/></textElement><text><![CDATA[Unit]]></text></staticText>
            <staticText><reportElement x="310" y="2" width="60"  height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font isBold="true" size="8"/></textElement><text><![CDATA[Stock]]></text></staticText>
            <staticText><reportElement x="370" y="2" width="55"  height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font isBold="true" size="8"/></textElement><text><![CDATA[Min]]></text></staticText>
            <staticText><reportElement x="425" y="2" width="65"  height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font isBold="true" size="8"/></textElement><text><![CDATA[Value]]></text></staticText>
            <staticText><reportElement x="490" y="2" width="45"  height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font isBold="true" size="8"/></textElement><text><![CDATA[Status]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16">
            <rectangle><reportElement x="0" y="0" width="535" height="16" backcolor="#EEF0FB" mode="Opaque">
                <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression></reportElement>
                <graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
            <textField><reportElement x="0"   y="1" width="165" height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{product_name}]]></textFieldExpression></textField>
            <textField><reportElement x="165" y="1" width="100" height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{category}]]></textFieldExpression></textField>
            <textField><reportElement x="265" y="1" width="45"  height="14"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{unit}]]></textFieldExpression></textField>
            <textField pattern="#,##0.000"><reportElement x="310" y="1" width="60" height="14"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{current_stock}]]></textFieldExpression></textField>
            <textField pattern="#,##0.000"><reportElement x="370" y="1" width="55" height="14"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{minimum_stock}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="425" y="1" width="65" height="14"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{stock_value}]]></textFieldExpression></textField>
            <!-- Status with colour: LOW=orange, OUT=red, OK=green -->
            <textField><reportElement x="490" y="1" width="45" height="14">
                <printWhenExpression><![CDATA["LOW".equals($F{stock_status})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["⚠ LOW"]]></textFieldExpression></textField>
            <textField><reportElement x="490" y="1" width="45" height="14">
                <printWhenExpression><![CDATA["OK".equals($F{stock_status})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["OK"]]></textFieldExpression></textField>
        </band>
    </detail>

    <summary>
        <band height="28">
            <line><reportElement x="0" y="2" width="535" height="1"/></line>
            <staticText><reportElement x="300" y="8" width="125" height="14"/>
                <textElement textAlignment="Right"><font isBold="true" size="10"/></textElement>
                <text><![CDATA[Total Stock Value:]]></text></staticText>
            <textField pattern="#,##0.00"><reportElement x="425" y="8" width="110" height="14"/>
                <textElement textAlignment="Right"><font isBold="true" size="11"/></textElement>
                <textFieldExpression><![CDATA[$V{TOTAL_VALUE}]]></textFieldExpression></textField>
        </band>
    </summary>

</jasperReport>
