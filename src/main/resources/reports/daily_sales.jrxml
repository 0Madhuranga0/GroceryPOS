<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="daily_sales" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="30" bottomMargin="30" whenNoDataType="AllSectionsNoDetail">

    <!-- ── Parameters ── -->
    <parameter name="STORE_NAME"    class="java.lang.String" isForPrompting="false"/>
    <parameter name="STORE_ADDRESS" class="java.lang.String" isForPrompting="false"/>
    <parameter name="STORE_PHONE"   class="java.lang.String" isForPrompting="false"/>
    <parameter name="CURRENCY"      class="java.lang.String" isForPrompting="false"/>
    <parameter name="P_DATE_FROM"   class="java.lang.String"/>
    <parameter name="P_DATE_TO"     class="java.lang.String"/>
    <parameter name="P_TITLE"       class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["Sales Report"]]></defaultValueExpression>
    </parameter>

    <!-- ── Query ── -->
    <queryString>
        <![CDATA[
        SELECT
            s.invoice_number,
            DATE_FORMAT(s.sale_date, '%d/%m/%Y %H:%i') AS sale_date,
            COALESCE(c.name, 'Walk-in')                AS customer,
            u.full_name                                 AS cashier,
            s.subtotal,
            s.discount_amount,
            s.tax_amount,
            s.grand_total,
            s.payment_method,
            s.cash_received,
            s.change_amount,
            s.status
        FROM   sales s
        LEFT JOIN customers c ON c.id = s.customer_id
        JOIN   users u        ON u.id = s.user_id
        WHERE  DATE(s.sale_date) BETWEEN $P{P_DATE_FROM} AND $P{P_DATE_TO}
        ORDER  BY s.sale_date
        ]]>
    </queryString>

    <!-- ── Fields ── -->
    <field name="invoice_number"  class="java.lang.String"/>
    <field name="sale_date"       class="java.lang.String"/>
    <field name="customer"        class="java.lang.String"/>
    <field name="cashier"         class="java.lang.String"/>
    <field name="subtotal"        class="java.math.BigDecimal"/>
    <field name="discount_amount" class="java.math.BigDecimal"/>
    <field name="tax_amount"      class="java.math.BigDecimal"/>
    <field name="grand_total"     class="java.math.BigDecimal"/>
    <field name="payment_method"  class="java.lang.String"/>
    <field name="status"          class="java.lang.String"/>

    <!-- ── Variables ── -->
    <variable name="TOTAL_SALES" class="java.math.BigDecimal"
              calculation="Sum" resetType="Report">
        <variableExpression><![CDATA[$F{grand_total}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="ROW_COUNT" class="java.lang.Integer"
              calculation="Count" resetType="Report">
        <variableExpression><![CDATA[$F{invoice_number}]]></variableExpression>
    </variable>

    <!-- ═══════════════ TITLE ═══════════════ -->
    <title>
        <band height="80">
            <!-- Store name -->
            <textField>
                <reportElement x="0" y="0" width="535" height="24"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{STORE_NAME}]]></textFieldExpression>
            </textField>
            <!-- Store address -->
            <textField>
                <reportElement x="0" y="24" width="535" height="16"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{STORE_ADDRESS} + "  |  " + $P{STORE_PHONE}]]></textFieldExpression>
            </textField>
            <!-- Report title -->
            <textField>
                <reportElement x="0" y="46" width="535" height="20"/>
                <textElement textAlignment="Center">
                    <font size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{P_TITLE}]]></textFieldExpression>
            </textField>
            <!-- Date range -->
            <textField>
                <reportElement x="0" y="66" width="535" height="14"/>
                <textElement textAlignment="Center"><font size="9" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Period: " + $P{P_DATE_FROM} + "  to  " + $P{P_DATE_TO}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- ═══════════════ COLUMN HEADER ═══════════════ -->
    <columnHeader>
        <band height="20">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="20" backcolor="#283593"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText><reportElement x="0"   y="2" width="100" height="16" forecolor="#FFFFFF"/>
                <textElement><font isBold="true" size="8"/></textElement>
                <text><![CDATA[Invoice #]]></text></staticText>
            <staticText><reportElement x="100" y="2" width="95"  height="16" forecolor="#FFFFFF"/>
                <textElement><font isBold="true" size="8"/></textElement>
                <text><![CDATA[Date]]></text></staticText>
            <staticText><reportElement x="195" y="2" width="100" height="16" forecolor="#FFFFFF"/>
                <textElement><font isBold="true" size="8"/></textElement>
                <text><![CDATA[Customer]]></text></staticText>
            <staticText><reportElement x="295" y="2" width="80"  height="16" forecolor="#FFFFFF"/>
                <textElement><font isBold="true" size="8"/></textElement>
                <text><![CDATA[Cashier]]></text></staticText>
            <staticText><reportElement x="375" y="2" width="75"  height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font isBold="true" size="8"/></textElement>
                <text><![CDATA[Total]]></text></staticText>
            <staticText><reportElement x="450" y="2" width="50"  height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font isBold="true" size="8"/></textElement>
                <text><![CDATA[Payment]]></text></staticText>
            <staticText><reportElement x="500" y="2" width="35"  height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font isBold="true" size="8"/></textElement>
                <text><![CDATA[Status]]></text></staticText>
        </band>
    </columnHeader>

    <!-- ═══════════════ DETAIL ═══════════════ -->
    <detail>
        <band height="16">
            <!-- Alternating row background -->
            <rectangle>
                <reportElement x="0" y="0" width="535" height="16"
                               backcolor="#EEF0FB" mode="Opaque">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <textField><reportElement x="0"   y="1" width="100" height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{invoice_number}]]></textFieldExpression></textField>
            <textField><reportElement x="100" y="1" width="95"  height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{sale_date}]]></textFieldExpression></textField>
            <textField><reportElement x="195" y="1" width="100" height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{customer}]]></textFieldExpression></textField>
            <textField><reportElement x="295" y="1" width="80"  height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{cashier}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="375" y="1" width="75" height="14"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{grand_total}]]></textFieldExpression></textField>
            <textField><reportElement x="450" y="1" width="50"  height="14"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{payment_method}]]></textFieldExpression></textField>
            <textField><reportElement x="500" y="1" width="35"  height="14"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression></textField>
        </band>
    </detail>

    <!-- ═══════════════ SUMMARY ═══════════════ -->
    <summary>
        <band height="50">
            <line><reportElement x="0" y="4" width="535" height="1"/></line>
            <staticText><reportElement x="0"   y="10" width="200" height="16"/>
                <textElement><font isBold="true" size="10"/></textElement>
                <text><![CDATA[Total Transactions:]]></text></staticText>
            <textField><reportElement x="200" y="10" width="100" height="16"/>
                <textElement><font isBold="true" size="10"/></textElement>
                <textFieldExpression><![CDATA[$V{ROW_COUNT}]]></textFieldExpression></textField>
            <staticText><reportElement x="300" y="10" width="100" height="16"/>
                <textElement textAlignment="Right"><font isBold="true" size="10"/></textElement>
                <text><![CDATA[Grand Total:]]></text></staticText>
            <textField pattern="#,##0.00"><reportElement x="400" y="10" width="135" height="16"/>
                <textElement textAlignment="Right"><font isBold="true" size="12"/></textElement>
                <textFieldExpression><![CDATA[$V{TOTAL_SALES}]]></textFieldExpression></textField>
            <!-- Generated timestamp -->
            <textField pattern="dd/MM/yyyy HH:mm"><reportElement x="0" y="34" width="535" height="12"/>
                <textElement textAlignment="Right"><font size="7" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
        </band>
    </summary>

</jasperReport>
