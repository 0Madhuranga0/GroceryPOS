<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="purchase_history" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="30" bottomMargin="30" whenNoDataType="AllSectionsNoDetail">

    <parameter name="STORE_NAME"  class="java.lang.String" isForPrompting="false"/>
    <parameter name="CURRENCY"    class="java.lang.String" isForPrompting="false"/>
    <parameter name="P_DATE_FROM" class="java.lang.String"/>
    <parameter name="P_DATE_TO"   class="java.lang.String"/>

    <queryString>
        <![CDATA[
        SELECT
            p.purchase_number,
            DATE_FORMAT(p.purchase_date,'%d/%m/%Y') AS purchase_date,
            s.name                                  AS supplier,
            p.supplier_invoice,
            u.full_name                             AS recorded_by,
            p.total_amount,
            p.status
        FROM   purchases p
        JOIN   suppliers s ON s.id = p.supplier_id
        JOIN   users     u ON u.id = p.user_id
        WHERE  DATE(p.purchase_date) BETWEEN $P{P_DATE_FROM} AND $P{P_DATE_TO}
        ORDER  BY p.purchase_date DESC
        ]]>
    </queryString>

    <field name="purchase_number"  class="java.lang.String"/>
    <field name="purchase_date"    class="java.lang.String"/>
    <field name="supplier"         class="java.lang.String"/>
    <field name="supplier_invoice" class="java.lang.String"/>
    <field name="recorded_by"      class="java.lang.String"/>
    <field name="total_amount"     class="java.math.BigDecimal"/>
    <field name="status"           class="java.lang.String"/>

    <variable name="GRAND_TOTAL" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
        <variableExpression><![CDATA[$F{total_amount}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <title>
        <band height="72">
            <textField><reportElement x="0" y="0" width="535" height="22"/>
                <textElement textAlignment="Center"><font size="15" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{STORE_NAME}]]></textFieldExpression></textField>
            <staticText><reportElement x="0" y="24" width="535" height="18"/>
                <textElement textAlignment="Center"><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Purchase History Report]]></text></staticText>
            <textField><reportElement x="0" y="44" width="535" height="14"/>
                <textElement textAlignment="Center"><font size="9" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Period: " + $P{P_DATE_FROM} + " to " + $P{P_DATE_TO}]]></textFieldExpression></textField>
            <line><reportElement x="0" y="66" width="535" height="1"/></line>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <rectangle><reportElement x="0" y="0" width="535" height="20" backcolor="#1a237e"/>
                <graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
            <staticText><reportElement x="0"   y="2" width="100" height="16" forecolor="#FFFFFF"/>
                <textElement><font isBold="true" size="8"/></textElement><text><![CDATA[Purchase #]]></text></staticText>
            <staticText><reportElement x="100" y="2" width="75"  height="16" forecolor="#FFFFFF"/>
                <textElement><font isBold="true" size="8"/></textElement><text><![CDATA[Date]]></text></staticText>
            <staticText><reportElement x="175" y="2" width="130" height="16" forecolor="#FFFFFF"/>
                <textElement><font isBold="true" size="8"/></textElement><text><![CDATA[Supplier]]></text></staticText>
            <staticText><reportElement x="305" y="2" width="90"  height="16" forecolor="#FFFFFF"/>
                <textElement><font isBold="true" size="8"/></textElement><text><![CDATA[Sup. Invoice]]></text></staticText>
            <staticText><reportElement x="395" y="2" width="80"  height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font isBold="true" size="8"/></textElement><text><![CDATA[Total]]></text></staticText>
            <staticText><reportElement x="475" y="2" width="60"  height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font isBold="true" size="8"/></textElement><text><![CDATA[Status]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16">
            <rectangle><reportElement x="0" y="0" width="535" height="16" backcolor="#E8EAF6" mode="Opaque">
                <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression></reportElement>
                <graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
            <textField><reportElement x="0"   y="1" width="100" height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{purchase_number}]]></textFieldExpression></textField>
            <textField><reportElement x="100" y="1" width="75"  height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{purchase_date}]]></textFieldExpression></textField>
            <textField><reportElement x="175" y="1" width="130" height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{supplier}]]></textFieldExpression></textField>
            <textField><reportElement x="305" y="1" width="90"  height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{supplier_invoice} != null ? $F{supplier_invoice} : "—"]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="395" y="1" width="80" height="14"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{total_amount}]]></textFieldExpression></textField>
            <textField><reportElement x="475" y="1" width="60"  height="14"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression></textField>
        </band>
    </detail>

    <summary>
        <band height="28">
            <line><reportElement x="0" y="2" width="535" height="1"/></line>
            <staticText><reportElement x="300" y="8" width="95" height="14"/>
                <textElement textAlignment="Right"><font isBold="true" size="10"/></textElement>
                <text><![CDATA[Total Purchases:]]></text></staticText>
            <textField pattern="#,##0.00"><reportElement x="395" y="8" width="140" height="14"/>
                <textElement textAlignment="Right"><font isBold="true" size="11"/></textElement>
                <textFieldExpression><![CDATA[$V{GRAND_TOTAL}]]></textFieldExpression></textField>
        </band>
    </summary>

</jasperReport>
