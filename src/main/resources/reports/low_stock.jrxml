<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="low_stock" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="30" bottomMargin="30" whenNoDataType="AllSectionsNoDetail">

    <parameter name="STORE_NAME" class="java.lang.String" isForPrompting="false"/>
    <parameter name="CURRENCY"   class="java.lang.String" isForPrompting="false"/>

    <queryString>
        <![CDATA[
        SELECT
            p.barcode,
            p.name                          AS product_name,
            COALESCE(c.name, '—')           AS category,
            COALESCE(s.name, '—')           AS supplier,
            p.unit,
            p.current_stock,
            p.minimum_stock,
            p.minimum_stock - p.current_stock AS shortage,
            p.purchase_price
        FROM   products p
        LEFT JOIN categories c ON c.id = p.category_id
        LEFT JOIN suppliers  s ON s.id = p.supplier_id
        WHERE  p.status = 'ACTIVE'
        AND    p.current_stock <= p.minimum_stock
        ORDER  BY shortage DESC, p.name
        ]]>
    </queryString>

    <field name="barcode"       class="java.lang.String"/>
    <field name="product_name"  class="java.lang.String"/>
    <field name="category"      class="java.lang.String"/>
    <field name="supplier"      class="java.lang.String"/>
    <field name="unit"          class="java.lang.String"/>
    <field name="current_stock" class="java.math.BigDecimal"/>
    <field name="minimum_stock" class="java.math.BigDecimal"/>
    <field name="shortage"      class="java.math.BigDecimal"/>
    <field name="purchase_price"class="java.math.BigDecimal"/>

    <title>
        <band height="76">
            <textField><reportElement x="0" y="0" width="535" height="22"/>
                <textElement textAlignment="Center"><font size="15" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{STORE_NAME}]]></textFieldExpression></textField>
            <staticText><reportElement x="0" y="24" width="535" height="18"/>
                <textElement textAlignment="Center"><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Low Stock Alert Report]]></text></staticText>
            <textField pattern="dd/MM/yyyy HH:mm"><reportElement x="0" y="44" width="535" height="14"/>
                <textElement textAlignment="Center"><font size="9" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
            <staticText><reportElement x="0" y="60" width="535" height="14"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <text><![CDATA[Products where current stock is at or below minimum stock level]]></text></staticText>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <rectangle><reportElement x="0" y="0" width="535" height="20" backcolor="#b71c1c"/>
                <graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
            <staticText><reportElement x="0"   y="2" width="155" height="16" forecolor="#FFFFFF"/>
                <textElement><font isBold="true" size="8"/></textElement><text><![CDATA[Product]]></text></staticText>
            <staticText><reportElement x="155" y="2" width="90"  height="16" forecolor="#FFFFFF"/>
                <textElement><font isBold="true" size="8"/></textElement><text><![CDATA[Category]]></text></staticText>
            <staticText><reportElement x="245" y="2" width="90"  height="16" forecolor="#FFFFFF"/>
                <textElement><font isBold="true" size="8"/></textElement><text><![CDATA[Supplier]]></text></staticText>
            <staticText><reportElement x="335" y="2" width="45"  height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font isBold="true" size="8"/></textElement><text><![CDATA[Unit]]></text></staticText>
            <staticText><reportElement x="380" y="2" width="50"  height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font isBold="true" size="8"/></textElement><text><![CDATA[Stock]]></text></staticText>
            <staticText><reportElement x="430" y="2" width="50"  height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font isBold="true" size="8"/></textElement><text><![CDATA[Min]]></text></staticText>
            <staticText><reportElement x="480" y="2" width="55"  height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font isBold="true" size="8"/></textElement><text><![CDATA[Shortage]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16">
            <rectangle><reportElement x="0" y="0" width="535" height="16" backcolor="#FFEBEE" mode="Opaque">
                <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression></reportElement>
                <graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
            <textField><reportElement x="0"   y="1" width="155" height="14"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{product_name}]]></textFieldExpression></textField>
            <textField><reportElement x="155" y="1" width="90"  height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{category}]]></textFieldExpression></textField>
            <textField><reportElement x="245" y="1" width="90"  height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{supplier}]]></textFieldExpression></textField>
            <textField><reportElement x="335" y="1" width="45"  height="14"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{unit}]]></textFieldExpression></textField>
            <textField pattern="#,##0.000"><reportElement x="380" y="1" width="50" height="14"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{current_stock}]]></textFieldExpression></textField>
            <textField pattern="#,##0.000"><reportElement x="430" y="1" width="50" height="14"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{minimum_stock}]]></textFieldExpression></textField>
            <textField pattern="#,##0.000"><reportElement x="480" y="1" width="55" height="14"/>
                <textElement textAlignment="Right"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{shortage}]]></textFieldExpression></textField>
        </band>
    </detail>

    <noData>
        <band height="40">
            <staticText><reportElement x="0" y="10" width="535" height="20"/>
                <textElement textAlignment="Center"><font size="12" isItalic="true"/></textElement>
                <text><![CDATA[All products are adequately stocked.]]></text></staticText>
        </band>
    </noData>

</jasperReport>
