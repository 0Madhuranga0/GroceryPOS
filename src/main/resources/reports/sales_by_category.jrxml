<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="sales_by_category" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="30" bottomMargin="30" whenNoDataType="AllSectionsNoDetail">

    <parameter name="STORE_NAME"    class="java.lang.String" isForPrompting="false"/>
    <parameter name="STORE_ADDRESS" class="java.lang.String" isForPrompting="false"/>
    <parameter name="CURRENCY"      class="java.lang.String" isForPrompting="false"/>
    <parameter name="P_DATE_FROM"   class="java.lang.String"/>
    <parameter name="P_DATE_TO"     class="java.lang.String"/>

    <queryString>
        <![CDATA[
        SELECT
            COALESCE(c.name, 'Uncategorised')  AS category,
            COUNT(DISTINCT s.id)               AS num_transactions,
            SUM(si.quantity)                   AS total_qty,
            SUM(si.total_price)                AS total_revenue,
            SUM(si.quantity * p.purchase_price)AS total_cost,
            SUM(si.total_price) - SUM(si.quantity * p.purchase_price) AS profit
        FROM   sale_items si
        JOIN   products p  ON p.id  = si.product_id
        LEFT JOIN categories c ON c.id = p.category_id
        JOIN   sales s     ON s.id  = si.sale_id
        WHERE  DATE(s.sale_date) BETWEEN $P{P_DATE_FROM} AND $P{P_DATE_TO}
        AND    s.status = 'COMPLETED'
        GROUP  BY c.name
        ORDER  BY total_revenue DESC
        ]]>
    </queryString>

    <field name="category"          class="java.lang.String"/>
    <field name="num_transactions"  class="java.lang.Long"/>
    <field name="total_qty"         class="java.math.BigDecimal"/>
    <field name="total_revenue"     class="java.math.BigDecimal"/>
    <field name="profit"            class="java.math.BigDecimal"/>

    <variable name="SUM_REV" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
        <variableExpression><![CDATA[$F{total_revenue}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="SUM_PROFIT" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
        <variableExpression><![CDATA[$F{profit}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <title>
        <band height="72">
            <textField><reportElement x="0" y="0" width="535" height="22"/>
                <textElement textAlignment="Center"><font size="15" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{STORE_NAME}]]></textFieldExpression></textField>
            <staticText><reportElement x="0" y="24" width="535" height="18"/>
                <textElement textAlignment="Center"><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Sales by Category Report]]></text></staticText>
            <textField><reportElement x="0" y="44" width="535" height="14"/>
                <textElement textAlignment="Center"><font size="9" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Period: " + $P{P_DATE_FROM} + " to " + $P{P_DATE_TO}]]></textFieldExpression></textField>
            <line><reportElement x="0" y="68" width="535" height="1"/></line>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <rectangle><reportElement x="0" y="0" width="535" height="20" backcolor="#283593"/>
                <graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
            <staticText><reportElement x="0"   y="2" width="170" height="16" forecolor="#FFFFFF"/>
                <textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Category]]></text></staticText>
            <staticText><reportElement x="170" y="2" width="100" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font isBold="true" size="9"/></textElement><text><![CDATA[Transactions]]></text></staticText>
            <staticText><reportElement x="270" y="2" width="80"  height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font isBold="true" size="9"/></textElement><text><![CDATA[Qty Sold]]></text></staticText>
            <staticText><reportElement x="350" y="2" width="95"  height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font isBold="true" size="9"/></textElement><text><![CDATA[Revenue]]></text></staticText>
            <staticText><reportElement x="445" y="2" width="90"  height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font isBold="true" size="9"/></textElement><text><![CDATA[Profit]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <rectangle><reportElement x="0" y="0" width="535" height="18" backcolor="#EEF0FB" mode="Opaque">
                <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression></reportElement>
                <graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
            <textField><reportElement x="0"   y="2" width="170" height="14"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{category}]]></textFieldExpression></textField>
            <textField><reportElement x="170" y="2" width="100" height="14"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{num_transactions}]]></textFieldExpression></textField>
            <textField pattern="#,##0.000"><reportElement x="270" y="2" width="80" height="14"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{total_qty}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="350" y="2" width="95" height="14"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{total_revenue}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="445" y="2" width="90" height="14"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{profit}]]></textFieldExpression></textField>
        </band>
    </detail>

    <summary>
        <band height="34">
            <line><reportElement x="0" y="2" width="535" height="1"/></line>
            <staticText><reportElement x="300" y="8" width="145" height="14"/>
                <textElement textAlignment="Right"><font isBold="true" size="10"/></textElement>
                <text><![CDATA[Total Revenue:]]></text></staticText>
            <textField pattern="#,##0.00"><reportElement x="445" y="8" width="90" height="14"/>
                <textElement textAlignment="Right"><font isBold="true" size="11"/></textElement>
                <textFieldExpression><![CDATA[$V{SUM_REV}]]></textFieldExpression></textField>
        </band>
    </summary>

</jasperReport>
